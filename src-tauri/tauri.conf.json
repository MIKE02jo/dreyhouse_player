{
  "productName": "DREYHOUSE PLAYER",
  "mainBinaryName": "dreyhouse-player",
  "version": "1.0.15",
  "identifier": "com.dreyhouse.player",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:4321",
    "beforeDevCommand": "node ./src/scripts/ensure-ffmpeg-sidecar.mjs && pnpm run dev",
    "beforeBuildCommand": "node ./src/scripts/ensure-ffmpeg-sidecar.mjs && pnpm run build"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "DREYHOUSE PLAYER",
        "width": 1300,
        "height": 850,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "focus": true,
        "visible": false,
        "decorations": false,
        "dragDropEnabled": false,
        "backgroundColor": "#0b0f14"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$DOWNLOAD/**",
          "$VIDEO/**",
          "$HOME/**",
          "$APPDATA/**",
          "$APPLOCALDATA/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "MIKE02jo",
    "category": "public.app-category.video",
    "copyright": "© 2026 DREYHOUSE PLAYER",
    "createUpdaterArtifacts": true,
    "android": {
      "versionCode": 100000590
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEYxRDlFQTFDM0VENUUwMkMKUldRczROVStIT3JaOFkxK1FTamZERkxoL0dLM0dtSENqQ2tIdVQyRzh4WTJuZEl5M3ZnVnlEYngK",
      "endpoints": [
        "https://github.com/MIKE02jo/dreyhouse_player/releases/latest/download/latest.json"
      ]
    }
  }
}
