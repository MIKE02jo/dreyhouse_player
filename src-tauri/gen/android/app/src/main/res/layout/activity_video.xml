<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <androidx.media3.ui.PlayerView
        android:id="@+id/player_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:resize_mode="fit"
        app:show_buffering="when_playing"
        app:use_controller="true"
        app:auto_show="true"
        app:hide_on_touch="true" />

    <!-- Explicit exit button - the system/gesture back action always worked,
         but nothing on screen told a touch user it existed, so many got
         stuck in fullscreen playback with no visible way out. Shown/hidden
         in step with PlayerView's own controls (see VideoActivity.kt). -->
    <ImageButton
        android:id="@+id/player_back_button"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="top|start"
        android:layout_marginStart="12dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_player_button"
        android:src="@drawable/ic_player_back"
        android:scaleType="center"
        android:contentDescription="@string/xt_player_back"
        android:soundEffectsEnabled="false" />

    <LinearLayout
        android:id="@+id/channel_list_overlay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:background="@color/xt_overlay_scrim"
        android:padding="16dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/channel_list_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/xt_row_text"
            android:textSize="13sp"
            android:letterSpacing="0.14"
            android:textAllCaps="true"
            android:paddingBottom="12dp"
            android:text="@string/xt_channels_title" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/channel_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:descendantFocusability="afterDescendants"
            android:clipToPadding="false" />
    </LinearLayout>
</FrameLayout>
