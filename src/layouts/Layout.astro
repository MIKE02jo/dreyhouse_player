  @keyframes xt-app-splash-nebula-drift-1 {
    from { transform: translate3d(calc(-50% - 15vmin), calc(-50% - 10vmin), 0) rotate(0deg) scale(1); }
    to   { transform: translate3d(calc(-50% + 13vmin), calc(-50% + 15vmin), 0) rotate(30deg) scale(1.18); }
  }
  @keyframes xt-app-splash-nebula-drift-2 {
    from { transform: translate3d(calc(-50% + 15vmin), calc(-50% - 13vmin), 0) rotate(0deg) scale(1.12); }
    to   { transform: translate3d(calc(-50% - 13vmin), calc(-50% + 10vmin), 0) rotate(-24deg) scale(1); }
  }
  @keyframes xt-app-splash-nebula-drift-band {
    from { transform: translate3d(calc(-50% - 8vmin), calc(-50% - 5vmin), 0) rotate(-22deg) scaleY(0.42); }
    to   { transform: translate3d(calc(-50% + 8vmin), calc(-50% + 5vmin), 0) rotate(-12deg) scaleY(0.48); }
  }
