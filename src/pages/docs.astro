---
import Layout from "@/layouts/Layout.astro"
---

<Layout pageTitle="Documentation" showVersion={false}>
  <main class="flex flex-1 min-h-0 flex-col items-center justify-center gap-3 p-8 text-center">
    <svg
      xmlns="http://www.w3.org/2000/svg"
      viewBox="34 40 172 160"
      aria-hidden="true"
      class="h-12 w-auto text-accent opacity-70">
      <path fill="currentColor" fill-rule="evenodd"
        d="M78,48 L162,48 L198,120 L162,192 L78,192 L42,120 Z
           M80,75 L138,75 L172,58 L192,70 L172,102 L172,83 L112,83 C98,83 90,92 90,104 L90,120 L60,120 L60,104 C60,86 68,75 80,75 Z
           M160,165 L102,165 L68,182 L48,170 L68,138 L68,157 L128,157 C142,157 150,148 150,136 L150,120 L180,120 L180,136 C180,154 172,165 160,165 Z" />
    </svg>
    <h1 class="text-lg font-semibold text-fg" data-i18n="docs.comingSoon.title">
      Documentation coming soon
    </h1>
    <p class="max-w-md text-sm text-fg-3" data-i18n="docs.comingSoon.body">
      DREYHOUSE PLAYER's own documentation site isn't published yet. In the
      meantime, the source code, issue tracker and discussions are on GitHub.
    </p>
    <a
      class="mt-2 inline-flex items-center gap-2 rounded-lg bg-accent px-4 py-2 text-sm font-semibold text-bg hover:opacity-90"
      href="https://github.com/MIKE02jo/dreyhouse_player"
      target="_blank"
      rel="noopener">
      github.com/MIKE02jo/dreyhouse_player
    </a>
  </main>
</Layout>
