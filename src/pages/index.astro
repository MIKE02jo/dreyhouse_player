---
import Layout from "@/layouts/Layout.astro";
import HubStrips from "@/components/HubStrips.svelte";
import WelcomeCard from "@/components/WelcomeCard.astro";
import {
	IconDeviceTv,
	IconMovie,
	IconStack2,
	IconCalendarTime,
	IconStar,
	IconSettings,
} from "@tabler/icons-svelte";
---

<Layout>
	<script is:inline>
		try {
			var raw = localStorage.getItem("xt_playlists") || "";
			var hasEntries = false;
			if (raw) {
				var parsed = JSON.parse(raw);
				hasEntries = !!(
					parsed &&
					Array.isArray(parsed.entries) &&
					parsed.entries.length
				);
			}
			if (!hasEntries) {
				document.documentElement.setAttribute("data-first-run", "true");
			}
		} catch (e) {}
	</script>

	<main
		class="flex-1 w-full mx-auto px-4 py-6 md:px-6 lg:px-8 max-w-480 flex flex-col gap-6">

		<a
			id="hub-expiration-banner"
			href="/settings"
			data-account-expiration="hub-banner"
			hidden
			class="rounded-xl px-4 py-3 text-sm font-medium
				border border-warn/35 bg-warn/10 text-warn
				data-[state=critical]:border-bad/45 data-[state=critical]:bg-bad/12 data-[state=critical]:text-bad
				data-[state=expired]:border-bad/55 data-[state=expired]:bg-bad/14 data-[state=expired]:text-bad
				hover:border-current
				outline-none transition-colors no-underline">
		</a>

		<section
			id="welcome"
			aria-labelledby="welcome-heading"
			class="welcome-section hidden flex-1 min-h-0 items-center justify-center py-6">
			<WelcomeCard />
		</section>

		<nav
			id="hub-tiles"
			aria-label="Browse" data-i18n-attr="aria-label:aria.browse"
			class="grid gap-3 sm:gap-4 shrink-0
				grid-cols-1 sm:grid-cols-3">
			<a
				href="/livetv"
				aria-label="Watch Live TV" data-i18n-attr="aria-label:aria.watchLiveTv"
				style="animation-delay: 50ms;"
				class="tile-enter tile-smarters group relative flex flex-col items-center justify-center text-center gap-3
					rounded-2xl border border-line bg-surface
					px-6 py-8 sm:py-10
					min-h-56 overflow-hidden
					transition-[transform,border-color,background-color] duration-300 ease-out
					hover:border-accent hover:bg-surface-2
					focus-visible:bg-surface-2
					hover:transform-[translateY(-2px)]
					focus-visible:transform-[translateY(-2px)]">
				<div
					id="livetv-tile-art"
					class="tile-art pointer-events-none"
					aria-hidden="true"></div>
				<div id="livetv-tile-progress" class="tile-progress" aria-hidden="true" hidden>
					<span class="tile-progress__fill"></span>
				</div>
				<p
					id="hero-eyebrow"
					class="relative z-10 font-sans text-eyebrow font-medium uppercase text-fg-3 tabular-nums"
					aria-hidden="true">
				</p>
				<span class="tile-smarters__badge relative z-10">
					<IconDeviceTv aria-hidden="true" stroke={1.5} class="size-9 sm:size-10" />
				</span>
				<h2
					data-i18n="nav.livetv"
					class="relative z-10 text-2xl sm:text-3xl font-bold tracking-[-0.01em] leading-tight
						text-fg group-hover:text-accent group-focus-visible:text-accent
						transition-colors duration-200">
					Live TV
				</h2>
				<p
					id="livetv-tile-sub"
					data-i18n="hub.tile.livetv.sub"
					class="relative z-10 text-sm text-fg-2 max-w-md font-sans tracking-tight truncate">
					Channels, and what's on right now.
				</p>
			</a>

			<a
				href="/movies"
				aria-label="Browse Movies" data-i18n-attr="aria-label:aria.browseMovies"
				style="animation-delay: 150ms;"
				class="tile-enter tile-smarters group relative overflow-hidden flex flex-col items-center justify-center text-center gap-3
					rounded-2xl border border-line bg-surface
					px-6 py-8 sm:py-10
					min-h-56
					transition-[transform,border-color,background-color] duration-300 ease-out
					hover:border-accent hover:bg-surface-2
					focus-visible:bg-surface-2
					hover:transform-[translateY(-2px)]
					focus-visible:transform-[translateY(-2px)]">
				<div
					id="movies-tile-art"
					class="tile-art pointer-events-none"
					aria-hidden="true"></div>
				<div id="movies-tile-progress" class="tile-progress" aria-hidden="true" hidden>
					<span class="tile-progress__fill"></span>
				</div>
				<span class="tile-smarters__badge relative z-10">
					<IconMovie aria-hidden="true" stroke={1.5} class="size-9 sm:size-10" />
				</span>
				<h2 data-i18n="nav.movies" class="relative z-10 text-2xl sm:text-3xl font-bold tracking-[-0.01em] leading-tight
					text-fg group-hover:text-accent group-focus-visible:text-accent
					transition-colors duration-200">
					Movies
				</h2>
				<p id="movies-tile-sub" data-i18n="hub.tile.movies.sub" class="relative z-10 text-sm text-fg-2">
					Browse the library.
				</p>
			</a>

			<a
				href="/series"
				aria-label="Browse Series" data-i18n-attr="aria-label:aria.browseSeries"
				style="animation-delay: 250ms;"
				class="tile-enter tile-smarters group relative overflow-hidden flex flex-col items-center justify-center text-center gap-3
					rounded-2xl border border-line bg-surface
					px-6 py-8 sm:py-10
					min-h-56
					transition-[transform,border-color,background-color] duration-300 ease-out
					hover:border-accent hover:bg-surface-2
					focus-visible:bg-surface-2
					hover:transform-[translateY(-2px)]
					focus-visible:transform-[translateY(-2px)]">
				<div
					id="series-tile-art"
					class="tile-art pointer-events-none"
					aria-hidden="true"></div>
				<div id="series-tile-progress" class="tile-progress" aria-hidden="true" hidden>
					<span class="tile-progress__fill"></span>
				</div>
				<span class="tile-smarters__badge relative z-10">
					<IconStack2 aria-hidden="true" stroke={1.5} class="size-9 sm:size-10" />
				</span>
				<h2 data-i18n="nav.series" class="relative z-10 text-2xl sm:text-3xl font-bold tracking-[-0.01em] leading-tight
					text-fg group-hover:text-accent group-focus-visible:text-accent
					transition-colors duration-200">
					Series
				</h2>
				<p id="series-tile-sub" data-i18n="hub.tile.series.sub" class="relative z-10 text-sm text-fg-2">
					Shows and full seasons.
				</p>
			</a>
		</nav>

		<!-- Secondary row, styled like the primary one but smaller - mirrors the
		     "Catch Up / Multiscreen / Settings" row IPTV Smarters shows below its
		     main tiles, using this app's own real destinations. Never gated -
		     these don't depend on the catalog being warm. -->
		<nav
			id="hub-secondary-tiles"
			aria-label="More" data-i18n-attr="aria-label:sidebar.more"
			class="grid gap-3 sm:gap-4 shrink-0 grid-cols-3">
			<a
				href="/epg"
				aria-label="EPG" data-i18n-attr="aria-label:nav.epg"
				style="animation-delay: 320ms;"
				class="tile-enter group flex flex-col items-center justify-center gap-2
					rounded-2xl border border-line bg-surface
					px-3 py-5 sm:py-6 text-center
					transition-[transform,border-color,background-color] duration-300 ease-out
					hover:border-accent hover:bg-surface-2 focus-visible:bg-surface-2
					hover:transform-[translateY(-2px)] focus-visible:transform-[translateY(-2px)]">
				<IconCalendarTime
					aria-hidden="true"
					stroke={1.5}
					class="size-6 sm:size-7 text-fg-3 transition-colors duration-200 group-hover:text-accent group-focus-visible:text-accent"
				/>
				<span data-i18n="nav.epg" class="text-sm font-medium text-fg-2 group-hover:text-fg">EPG</span>
			</a>
			<a
				href="/favorites"
				aria-label="Favorites" data-i18n-attr="aria-label:nav.favorites"
				style="animation-delay: 380ms;"
				class="tile-enter group flex flex-col items-center justify-center gap-2
					rounded-2xl border border-line bg-surface
					px-3 py-5 sm:py-6 text-center
					transition-[transform,border-color,background-color] duration-300 ease-out
					hover:border-accent hover:bg-surface-2 focus-visible:bg-surface-2
					hover:transform-[translateY(-2px)] focus-visible:transform-[translateY(-2px)]">
				<IconStar
					aria-hidden="true"
					stroke={1.5}
					class="size-6 sm:size-7 text-fg-3 transition-colors duration-200 group-hover:text-accent group-focus-visible:text-accent"
				/>
				<span data-i18n="nav.favorites" class="text-sm font-medium text-fg-2 group-hover:text-fg">Favorites</span>
			</a>
			<a
				href="/settings"
				aria-label="Settings" data-i18n-attr="aria-label:nav.settings"
				style="animation-delay: 440ms;"
				class="tile-enter group flex flex-col items-center justify-center gap-2
					rounded-2xl border border-line bg-surface
					px-3 py-5 sm:py-6 text-center
					transition-[transform,border-color,background-color] duration-300 ease-out
					hover:border-accent hover:bg-surface-2 focus-visible:bg-surface-2
					hover:transform-[translateY(-2px)] focus-visible:transform-[translateY(-2px)]">
				<IconSettings
					aria-hidden="true"
					stroke={1.5}
					class="size-6 sm:size-7 text-fg-3 transition-colors duration-200 group-hover:text-accent group-focus-visible:text-accent"
				/>
				<span data-i18n="nav.settings" class="text-sm font-medium text-fg-2 group-hover:text-fg">Settings</span>
			</a>
		</nav>

		<HubStrips client:load />
	</main>
</Layout>

<style>
	@keyframes tile-enter {
		from {
			opacity: 0;
			transform: translateY(12px);
		}
	}
	.tile-enter {
		animation: tile-enter 500ms cubic-bezier(0.16, 1, 0.3, 1) backwards;
	}
	html[data-first-run="true"] #hub-tiles,
	html[data-first-run="true"] #hub-secondary-tiles {
		display: none;
	}
	html[data-first-run="true"] #welcome {
		display: flex;
	}

	/* Icon-in-a-badge treatment for the primary tiles, matching the layout
	   of the reference IPTV-Smarters-style screen (centered icon, bold
	   label below) while staying entirely within this app's own accent
	   color instead of Smarters' multicolor gradients. */
	.tile-smarters__badge {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 4.5rem;
		height: 4.5rem;
		border-radius: 9999px;
		background: var(--color-accent-soft);
		color: var(--color-accent);
		transition: transform 200ms ease-out;
	}
	.tile-smarters:hover .tile-smarters__badge,
	.tile-smarters:focus-visible .tile-smarters__badge {
		transform: scale(1.06);
	}

	/* Tap-to-download state (see catalog-gate.ts): the tapped tile shows a
	   thin fill bar at its base while its own catalog kind is downloading.
	   Clicks stay live (not pointer-events:none) so a tap on a downloading
	   tile can still explain why with a toast instead of doing nothing. */
	#hub-tiles a.tile--downloading {
		cursor: wait;
	}
	#hub-tiles a.tile--downloading:hover {
		border-color: var(--color-line);
		background-color: var(--color-surface);
		transform: none;
	}
	.tile-progress {
		position: absolute;
		inset: auto 0 0 0;
		height: 3px;
		background: var(--color-line);
		z-index: 20;
	}
	.tile-progress__fill {
		display: block;
		height: 100%;
		width: 0%;
		background: var(--color-accent);
		transition: width 200ms ease-out;
	}
	.tile-progress[data-indeterminate="true"] .tile-progress__fill {
		width: 40% !important;
		animation: tile-progress-indeterminate 1.1s ease-in-out infinite;
	}
	@keyframes tile-progress-indeterminate {
		0%   { transform: translateX(-100%); }
		100% { transform: translateX(250%); }
	}
	@media (prefers-reduced-motion: reduce) {
		.tile-progress[data-indeterminate="true"] .tile-progress__fill {
			animation: none;
			transform: none;
		}
	}
</style>

<script>
	import "../scripts/updater-startup.js";
	import { log } from "@/scripts/lib/log.js";
	import { t, LOCALE_EVENT } from "@/scripts/lib/i18n.js";
	import { getEntries, getActiveEntry, loadCreds, addEntry } from "@/scripts/lib/creds.js";
	import { getCached, hydrate as hydrateCache } from "@/scripts/lib/cache.js";
	import { getRecents, ensureLoaded as ensurePrefsLoaded } from "@/scripts/lib/preferences.js";
	import { getProgrammesSync, getNowNextForChannel, loadProgrammes } from "@/scripts/lib/epg-data.js";
	import { toastWarn } from "@/scripts/lib/toast.js";
	import { bindGatedLinks } from "@/scripts/lib/catalog-gate.ts";
	import { peekDeviceId, checkDeviceActivation, buildEntryPatch } from "@/scripts/lib/device-activation.ts";

	// Tap-to-download: Live TV/Movies/Series stay untouched until the user
	// actually taps one, at which point warmupActive() runs (all three kinds
	// together) and every tile shows its own live percentage until it's
	// done. Only then does navigation happen - see catalog-gate.ts.
	const hubTiles = document.getElementById("hub-tiles");
	/** @type {Record<string, {sub: HTMLElement|null, progress: HTMLElement|null, fill: HTMLElement|null, defaultSubKey: string}>} */
	const tileParts = {
		live: {
			sub: document.getElementById("livetv-tile-sub"),
			progress: document.getElementById("livetv-tile-progress"),
			fill: document.querySelector("#livetv-tile-progress .tile-progress__fill"),
			defaultSubKey: "hub.tile.livetv.sub",
		},
		vod: {
			sub: document.getElementById("movies-tile-sub"),
			progress: document.getElementById("movies-tile-progress"),
			fill: document.querySelector("#movies-tile-progress .tile-progress__fill"),
			defaultSubKey: "hub.tile.movies.sub",
		},
		series: {
			sub: document.getElementById("series-tile-sub"),
			progress: document.getElementById("series-tile-progress"),
			fill: document.querySelector("#series-tile-progress .tile-progress__fill"),
			defaultSubKey: "hub.tile.series.sub",
		},
	};

	const KIND_HREF = { live: "/livetv", vod: "/movies", series: "/series" };

	// Only the tapped tile shows the downloading state - the other two are
	// untouched, since each kind now fetches independently (see
	// catalog-gate.ts). Tapping one must never make the other two look busy.
	function setTileDownloading(kind, downloading) {
		if (!hubTiles) return;
		const parts = tileParts[kind];
		if (!parts) return;
		const link = hubTiles.querySelector(`a[href="${KIND_HREF[kind]}"]`);
		link?.classList.toggle("tile--downloading", downloading);
		if (parts.progress) parts.progress.hidden = !downloading;
		if (downloading) {
			parts.progress?.setAttribute("data-indeterminate", "true");
			if (parts.sub) parts.sub.textContent = t("hub.tile.downloading");
		} else {
			if (parts.fill) parts.fill.style.width = "0%";
			if (parts.sub) parts.sub.textContent = t(parts.defaultSubKey);
		}
	}

	if (hubTiles) {
		bindGatedLinks(hubTiles, {
			onStart: (kind) => setTileDownloading(kind, true),
			onProgress: (kind, pct) => {
				const parts = tileParts[kind];
				if (!parts?.fill || !parts.progress) return;
				if (pct == null) {
					parts.progress.setAttribute("data-indeterminate", "true");
					return;
				}
				parts.progress.removeAttribute("data-indeterminate");
				parts.fill.style.width = `${pct}%`;
				if (parts.sub) parts.sub.textContent = t("hub.tile.downloadingPct", { pct });
			},
			onDone: (kind) => setTileDownloading(kind, false),
			onBlocked: () => toastWarn(t("nav.stillLoading")),
		});
	}

	const eyebrow = document.getElementById("hero-eyebrow");
	let heroChannelCount = 0;
	const setHeroChannelCount = (count) => {
		const next = Number.isFinite(count) ? Math.max(0, count) : 0;
		if (next === heroChannelCount) return;
		heroChannelCount = next;
		window.__refreshHeroEyebrow?.();
	};
	if (eyebrow) {
		const greet = (hour) => {
			if (hour < 5) return t("hub.greeting.night");
			if (hour < 12) return t("hub.greeting.morning");
			if (hour < 18) return t("hub.greeting.afternoon");
			if (hour < 22) return t("hub.greeting.evening");
			return t("hub.greeting.night");
		};
		const update = () => {
			const now = new Date();
			const time = new Intl.DateTimeFormat(undefined, {
				hour: "numeric",
				minute: "2-digit",
			}).format(now);
			const parts = [greet(now.getHours()), time];
			if (heroChannelCount > 0) {
				parts.push(t("hub.channelCount", { count: heroChannelCount.toLocaleString() }));
			}
			eyebrow.textContent = parts.join(" · ");
		};
		update();
		setInterval(update, 30_000);
		window.__refreshHeroEyebrow = update;
		document.addEventListener(LOCALE_EVENT, update);
	}

	async function reconcileFirstRun() {
		const entries = await getEntries();
		const hasEntries = entries.length > 0;
		document.documentElement.toggleAttribute("data-first-run", !hasEntries);
		// Just the grid on this screen once a playlist is loaded - the mobile
		// bottom tab bar would only duplicate Live TV/Movies/Series that are
		// already right there as tiles. It's back as soon as you navigate
		// into any of those (Layout.astro renders it per-page, this toggle
		// only ever touches this one page's own instance of it).
		document.querySelector("[data-mobile-nav]")?.toggleAttribute("hidden", hasEntries);
		return hasEntries;
	}

	// A customer only sees the "Activate with a code" screen once, then
	// closes the app - a seller activating them minutes or hours later has
	// nothing to notify that screen even if it re-polls while open. So on
	// every app launch, if there's no playlist yet but a code was already
	// generated (i.e. the customer did visit /activate at some point),
	// silently re-check once here instead of requiring them to remember to
	// reopen that exact screen. Errors are swallowed - this is a courtesy
	// check, /activate's own "Check now" stays the reliable fallback.
	async function checkPendingActivationOnLaunch() {
		const deviceId = peekDeviceId();
		if (!deviceId) return;
		try {
			const result = await checkDeviceActivation(deviceId);
			if (result.status !== "active") return;
			await addEntry(buildEntryPatch(result));
			await reconcileFirstRun();
		} catch (err) {
			log.warn("[xt:hub] launch activation check failed:", err);
		}
	}

	window.addEventListener("load", async () => {
		const hasEntries = await reconcileFirstRun();
		if (!hasEntries) {
			document
				.querySelector("#welcome a.btn-primary")
				?.focus({ preventScroll: true });
			checkPendingActivationOnLaunch();
		}
	});

	document.addEventListener("xt:entries-updated", reconcileFirstRun);
	document.addEventListener("xt:active-changed", reconcileFirstRun);

	// ──────────────────────────────────────────────────────────
	// Hub dashboard signals
	// ──────────────────────────────────────────────────────────
	const liveTileArt = document.getElementById("livetv-tile-art");
	const liveTileSub = document.getElementById("livetv-tile-sub");
	const moviesTileArt = document.getElementById("movies-tile-art");
	const seriesTileArt = document.getElementById("series-tile-art");

	const rotators = [];
	function stopRotator() {
		for (const rotator of rotators) clearInterval(rotator);
		rotators.length = 0;
	}

	function startRotator(el, urls) {
		if (!el || !urls.length) return;
		const layers = [document.createElement("img"), document.createElement("img")];
		for (const layer of layers) {
			layer.className = "tile-art__layer";
			layer.alt = "";
			layer.decoding = "async";
			layer.loading = "eager";
			layer.referrerPolicy = "no-referrer";
			layer.onerror = () => {
				delete layer.dataset.on;
			};
			el.appendChild(layer);
		}
		let idx = 0;
		let active = 0;
		layers[active].src = urls[0];
		layers[active].dataset.on = "true";
		const advance = () => {
			if (document.hidden) return;
			idx = (idx + 1) % urls.length;
			const next = active === 0 ? 1 : 0;
			layers[next].src = urls[idx];
			layers[next].dataset.on = "true";
			delete layers[active].dataset.on;
			active = next;
		};
		rotators.push(setInterval(advance, 8000));
	}

	function pickRandom(arr, count) {
		if (arr.length <= count) return arr.slice();
		const seen = new Set();
		const out = [];
		while (out.length < count && seen.size < arr.length) {
			const idx = Math.floor(Math.random() * arr.length);
			if (seen.has(idx)) continue;
			seen.add(idx);
			out.push(arr[idx]);
		}
		return out;
	}

	async function setupTileArt() {
		try {
			stopRotator();
			const active = await getActiveEntry();
			if (!active) return;
			await Promise.all([
				hydrateCache(active._id, "vod").catch(() => {}),
				hydrateCache(active._id, "series").catch(() => {}),
				hydrateCache(active._id, "live").catch(() => {}),
				hydrateCache(active._id, "m3u").catch(() => {}),
			]);
			if (moviesTileArt) {
				const vod = (getCached(active._id, "vod")?.data || [])
					.filter((m) => m && m.logo)
					.map((m) => m.logo);
				const picks = pickRandom(vod, 6);
				moviesTileArt.replaceChildren();
				if (picks.length) startRotator(moviesTileArt, picks);
			}
			if (seriesTileArt) {
				const series = (getCached(active._id, "series")?.data || [])
					.filter((s) => s && s.logo)
					.map((s) => s.logo);
				const picks = pickRandom(series, 6);
				seriesTileArt.replaceChildren();
				if (picks.length) startRotator(seriesTileArt, picks);
			}
			await setupLiveSignals(active);
		} catch (e) {
			log.warn("[hub] setupTileArt failed:", e);
		}
	}

	async function setupLiveSignals(active) {
		if (!liveTileArt || !liveTileSub) return;
		await ensurePrefsLoaded();
		const recents = getRecents(active._id, "live") || [];
		const live = (getCached(active._id, "live")?.data || getCached(active._id, "m3u")?.data || []);
		setHeroChannelCount(live.length);
		const liveById = new Map(live.map((c) => [Number(c.id), c]));
		let lastChannel = null;
		if (recents.length) {
			lastChannel = liveById.get(Number(recents[0].id)) || {
				id: recents[0].id,
				name: recents[0].name,
				logo: recents[0].logo,
				tvgId: null,
			};
		}
		liveTileArt.replaceChildren();
		if (!lastChannel) {
			liveTileSub.textContent = t("hub.tile.livetv.sub");
			return;
		}
		if (lastChannel.logo) {
			const layer = document.createElement("img");
			layer.className = "tile-art__layer tile-art__layer--logo";
			layer.alt = "";
			layer.decoding = "async";
			layer.loading = "eager";
			layer.referrerPolicy = "no-referrer";
			layer.onerror = () => layer.remove();
			layer.src = lastChannel.logo;
			layer.dataset.on = "true";
			liveTileArt.appendChild(layer);
		}
		const tvgId = lastChannel.tvgId || "";
		const setOnAir = (programme) => {
			if (!programme) return false;
			liveTileSub.innerHTML =
				`<span class="text-fg-3 uppercase tracking-wider text-eyebrow font-semibold mr-2">${escapeHtml(t("hub.tile.livetv.onNow"))}</span>` +
				`<span class="text-fg-2">${escapeHtml(lastChannel.name)}</span>` +
				`<span class="text-fg-3 mx-1.5">·</span>` +
				`<span class="text-fg">${escapeHtml(programme.title)}</span>`;
			return true;
		};
		const cached = getProgrammesSync(active._id);
		const cachedHit = cached?.programmes && tvgId
			? setOnAir(getNowNextForChannel(cached.programmes, lastChannel, active._id).current)
			: false;
		if (!cachedHit) {
			liveTileSub.textContent = t("hub.tile.livetv.lastWatched", { name: lastChannel.name });
			if (tvgId) {
				try {
					const creds = await loadCreds();
					if (creds?.host) {
						const state = await loadProgrammes(active._id, creds);
						if (state?.programmes) {
							const { current } = getNowNextForChannel(state.programmes, lastChannel, active._id);
							if (current) setOnAir(current);
						}
					}
				} catch {}
			}
		}
	}

	function escapeHtml(s) {
		const d = document.createElement("div");
		d.textContent = s || "";
		return d.innerHTML;
	}

	if (typeof window !== "undefined") {
		window.requestIdleCallback
			? window.requestIdleCallback(setupTileArt, { timeout: 1500 })
			: setTimeout(setupTileArt, 400);
		document.addEventListener("xt:active-changed", setupTileArt);
		document.addEventListener("xt:catalog-warmed", setupTileArt);
	}
</script>
